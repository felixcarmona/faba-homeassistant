# MyFaba account (the one you use in the app; a dedicated account that the box is shared with is recommended)
MYFABA_USER=you@example.com
MYFABA_PASS=change-me
# Optional: pick a box explicitly (default: the first box of the account)
#MYFABA_MODULE_ID=
# Optional: where the bridge listens (defaults shown)
#FABA_BRIDGE_HOST=127.0.0.1
#FABA_BRIDGE_PORT=8090
